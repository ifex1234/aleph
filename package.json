{
  "name": "aleph",
  "version": "0.8.5",
  "author": "Zeravest Technologies",
  "main": "dist-electron/main.cjs",
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@dnd-kit/react": "^0.3.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fabric": "^7.4.0",
    "fuse.js": "^7.5.0",
    "koffi": "^2.14.0",
    "lucide-react": "^1.40.0",
    "onnxruntime-node": "^1.29.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-joyride": "^3.2.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.3"
  },
  "description": "Aleph - AI-powered Bible presentation application",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build": "tsc -b && vite build",
    "electron:build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "dist": "npm run electron:build && electron-builder --publish never",
    "release": "npm run electron:build && electron-builder --publish always",
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "download:bible-data": "bun run data/download-sources.ts",
    "build:bible": "bun run data/build-bible-db.ts",
    "build:hymns": "bun run data/build-hymns-db.ts",
    "download:model": "bun run data/download-model.ts",
    "download:whisper": "bun run data/download-whisper-model.ts",
    "download:whisper-bin": "bun run data/download-whisper-bin.ts",
    "export:verses": "bun run data/compute-embeddings.ts",
    "quantize:model": "optimum-cli onnxruntime quantize --onnx_model models/qwen3-embedding-0.6b/ --arm64 -o models/qwen3-embedding-0.6b-int8",
    "precompute:embeddings-py": "python3 data/precompute-embeddings.py",
    "setup:all": "bun run data/prepare-embeddings.ts",
    "publish:semantic": "node scripts/publish-semantic-assets.mjs",
    "setup:bundle": "bun run data/ci-build.ts",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "web:start": "cd web && bun run start",
    "web:lint": "cd web && bun run lint"
  },
  "type": "module"
}
